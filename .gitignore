# Node.js
node_modules/
npm-debug.log*
dist/
build/
.env

# Python cache (made when OBS or Python loads server.py)
__pycache__/
*.pyc

# Your own files stay on your computer: custom images, saved rundowns, logs and saved shows.
# The folders themselves are shared (each has a README.txt).
custom/*
!custom/README.txt
rundowns/*
!rundowns/README.txt
logs/*
!logs/README.txt
shows/*
!shows/README.txt
# The full-size originals of background videos that were re-encoded smaller (kept on this computer only)
assets/originals/
# Performance test results (tests/perf.py): different on every computer
tests/results/

# The AKTA break/return settings hold the private key, so they never get committed.
# (The .tmp file only exists for a moment while the settings are being saved.)
akta-config.json
akta-config.json.tmp

# Operating system and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

.claude
